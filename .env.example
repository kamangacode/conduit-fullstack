# Variables de la stack de développement locale (docker-compose.yml).
#
#   cp .env.example .env
#
# Toutes ont un défaut dans le docker-compose : ce fichier n'est nécessaire que
# pour s'en écarter — typiquement quand un des ports est déjà pris par un autre
# projet sur la machine.
#
# À ne pas confondre avec apps/api/.env, qui configure le process API et dont
# les variables sont validées au démarrage (apps/api/.env.example).
#
# Les identifiants ci-dessous sont des valeurs de DÉVELOPPEMENT LOCAL. En
# production, la configuration vient de la plateforme (Railway), jamais du dépôt.

# ─── Base de développement ──────────────────────────────────────────────────

POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit_dev
POSTGRES_PORT=5432

# ─── Base de test (profile `test`, tests d'intégration) ─────────────────────
#
# Démarrée uniquement par `pnpm test:integration`. Le nom de la base DOIT
# contenir « test » : le script et le setup Vitest refusent tous deux de purger
# une base qui ne s'annonce pas comme jetable.

POSTGRES_TEST_USER=conduit
POSTGRES_TEST_PASSWORD=conduit
POSTGRES_TEST_DB=conduit_test
# Volontairement loin des ports usuels : la base de dev occupe souvent 5432/5433.
POSTGRES_TEST_PORT=55432

# ─── Outils de développement ────────────────────────────────────────────────

# Adminer — inspection de la base : http://localhost:8080
ADMINER_PORT=8080

# Mailpit — capture des e-mails sortants : http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
