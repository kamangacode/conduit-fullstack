# Dépendances
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Artefacts dérivés du référentiel d'exigences : régénérables à tout moment par
# `pnpm requirements:matrix`, donc jamais committés (ADR 005).
docs/requirements/_generated/

# Tests & couverture
coverage/
.nyc_output/
playwright-report/
test-results/

# Secrets & environnement (voir Phase 3 — garde-fous secrets)
.env
.env.local
.env*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Journal de build local (mémoire de session, hors historique public)
/artifacts/build-log.md

# État et coûts d'orchestration Forge : mémoire de session interne, hors vitrine publique
# (les dossiers de planification req-driven, eux, sont versionnés)
/artifacts/cost/
artifacts/forge/**/state.md
artifacts/forge/**/*-shadow.md
artifacts/forge/**/*-shadow.json

# OS / éditeurs
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Cadre de développement local (non versionné)
/CLAUDE.md
/.claude/
.gstack/

# Test de mutation (item C8) — artefacts dérivés, régénérés par `pnpm mutation`.
# Même principe que la matrice de traçabilité (ADR 005) : ce qui se recalcule ne
# se versionne pas. Le score, lui, est consigné dans REQ-TEST-001, parce qu'un
# chiffre qu'aucun fichier ne porte se perd au premier `rm -rf`.
.stryker-tmp/
apps/api/reports/
