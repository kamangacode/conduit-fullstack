{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    // Le client Prisma est généré dans node_modules, hors de tout workspace :
    // Turbo ne peut donc pas le suivre comme un artefact, d'où `cache: false`.
    //
    // Le déclarer comme dépendance de graphe, plutôt que d'ajouter une étape à
    // chaque job de CI, est ce qui rend le graphe vrai : sans lui, `typecheck`
    // passe en local (client déjà généré par un run précédent) et échoue sur une
    // machine fraîche — le patron « câblé sur un chemin, absent de son frère »
    // que la rule 12 décrit, et qui s'est effectivement produit ici.
    //
    // Coût assumé : ~3 s ajoutées à chaque `pnpm test` / `pnpm typecheck`,
    // puisque la tâche n'est pas cacheable. C'est le prix d'un graphe qui ne
    // ment pas ; le supprimer de la lane rapide rouvrirait exactement le trou
    // qu'il ferme. Seul apps/api porte ce script, les autres l'ignorent.
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      // `NEXT_PUBLIC_API_URL` entre dans la clé de cache parce que Next l'inline
      // dans le bundle client **à la compilation**. Sans cette déclaration, deux
      // builds aux URL différentes auraient la même empreinte : la suite e2e,
      // qui construit le front avec l'URL de son API de test, se verrait
      // resservir l'artefact du build précédent — celui qui pointe vers le port
      // de développement. Les 128 tests échoueraient alors sur un diagnostic qui
      // ne parle pas de conformité (REQ-CONF-002 AC-4).
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      // La lane `test` ne produit volontairement aucun artefact : elle doit
      // rester la commande la plus rapide du dépôt (pre-push, boucle de
      // développement). Instrumenter la couverture ralentit l'exécution pour un
      // chiffre dont on n'a pas besoin à chaque itération — d'où un task dédié.
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    // Le canary de fail-fast démarre le vrai point d'entrée de l'API, donc il a
    // besoin de tout ce dont un process de production a besoin : le client
    // Prisma généré ET `@repo/shared` compilé. Il passe par le graphe pour la
    // même raison que `test:integration` — la première version était une étape
    // brute du job `Quality`, elle a échoué en CI sur
    // `MODULE_NOT_FOUND: @repo/shared` alors qu'elle passait en local, où le
    // build traînait d'un run précédent. Troisième occurrence du même patron
    // dans ce dépôt.
    //
    // `cache: false` : c'est une vérification, pas une production d'artefact.
    // Un « pass » resservi depuis le cache serait un garde-fou qui ne s'exécute
    // plus, ce qui est précisément l'échec que ce canary existe pour rendre
    // impossible.
    "verify:env-fail-fast": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
