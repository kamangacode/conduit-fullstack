# Configuration du process API (apps/api).
#
#   cp apps/api/.env.example apps/api/.env
#
# Ce fichier est le miroir documentaire de apps/api/src/config/env.ts, qui fait
# foi : l'API refuse de démarrer si une de ces variables manque ou ne respecte
# pas sa contrainte, avec un message qui nomme la variable fautive.
#
# Il est aussi lu par la CLI Prisma (`pnpm --filter @repo/api db:migrate`), qui
# résout DATABASE_URL depuis ce dossier.
#
# Ne jamais committer le `.env` réel : le hook pre-commit le refuse.

# ─── Runtime ────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# Port d'écoute de l'API. Le front (apps/web) tourne sur 3000.
PORT=3001

# ─── Base de données ────────────────────────────────────────────────────────

# URL PostgreSQL. Les identifiants ci-dessous correspondent au service
# `postgres` du docker-compose de développement (voir .env.example à la racine
# pour en changer le port).
DATABASE_URL=postgresql://conduit:conduit@localhost:5432/conduit_dev?schema=public

# ─── Authentification (spec RealWorld) ──────────────────────────────────────

# Secret de signature des JWT. Au moins 32 caractères, et SANS valeur par défaut
# côté code : un secret de développement qui a un défaut finit un jour en
# production sans que rien ne l'ait signalé.
#
#   openssl rand -hex 32
#
JWT_SECRET=remplacer-par-un-secret-genere-de-32-caracteres-minimum

# Durée de validité des tokens : un entier suivi de s, m, h ou d.
JWT_EXPIRES_IN=7d
